{
  "manifest_version": 3,
  "name": "Pratibimb",
  "version": "1.7.2",
  "version_name": "Commit 72",
  "description": "Syncs your new tab with the Windows desktop wallpaper.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://suggestqueries.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://grok.com/*",
        "*://x.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*"
      ],
      "js": [
        "llm.js"
      ],
      "run_at": "document_idle"
    }
  ]
}